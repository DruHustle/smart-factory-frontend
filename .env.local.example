# Copy to .env.local and replace every CHANGE_ME value.
# Docker Compose: docker compose --env-file .env.local --profile aas up --build -d --wait
# Node server: DOTENV_CONFIG_PATH=.env.local pnpm dev:server
NODE_ENV=development
BACKEND_DEPLOYMENT_MODE=compose
VITE_API_URL=/api
VITE_ENABLE_DEMO_ACCOUNTS=true
BACKEND_URL=http://localhost:3000
PORT=3000
DEBUG=true
ALLOWED_ORIGIN=http://localhost:3000
TRUST_PROXY=

DATABASE_URL=postgresql://smartfactory_local:CHANGE_ME_DATABASE_PASSWORD@database:5432/smart_factory_iot
DATABASE_SSL_MODE=disable
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
REDIS_PASSWORD=CHANGE_ME_UNIQUE_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_UNIQUE_REDIS_PASSWORD@redis:6379/0
BASYX_DB_PASSWORD=CHANGE_ME_UNIQUE_BASYX_DATABASE_PASSWORD

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
AAS_PROVISIONING_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
INGESTION_API_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
DASHBOARD_SERVICE_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_DATA=true

# Transactional email (configure on the worker service; never expose these to Vite).
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=smartfactory.notifications@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Smart Factory <smartfactory.notifications@gmail.com>
SMTP_ALLOW_ALL_RECIPIENTS=true
SMTP_ALLOWED_RECIPIENTS=
SMTP_ALLOWED_RECIPIENT_DOMAINS=

# Future Resend configuration after verifying a sender domain.
RESEND_API_KEY=
RESEND_FROM=Smart Factory <notifications@CHANGE_ME_VERIFIED_DOMAIN>
RESEND_ALLOWED_RECIPIENT_DOMAINS=

AAS_REPOSITORY_URL=http://aas-repository:8081
AAS_SUBMODEL_REPOSITORY_URL=http://submodel-repository:8083
AAS_CONCEPT_DESCRIPTION_REPOSITORY_URL=http://concept-description-repository:8085
AAS_REGISTRY_URL=http://aas-registry:8082
AAS_SUBMODEL_REGISTRY_URL=http://submodel-registry:8084
AASX_FILE_SERVER_URL=http://aasx-file-server:8086
AAS_ALLOW_UNAUTHENTICATED_LOCAL=true
AAS_OIDC_TOKEN_URL=
AAS_OIDC_DISCOVERY_URL=
AAS_OIDC_SCOPE=
AAS_OIDC_CLIENT_ID=
AAS_OIDC_CLIENT_SECRET=
AAS_PROVISIONING_API_URL=http://device-service:8080/api/assets

ASSISTANT_PROVIDER=openai_compatible
ASSISTANT_INCLUDE_LIVE_CONTEXT=true
ASSISTANT_GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_GEMINI_FALLBACK_MODEL=
ASSISTANT_GEMINI_MODEL_CANDIDATES=gemini-2.5-flash
ASSISTANT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_GROQ_MODEL=openai/gpt-oss-120b
ASSISTANT_GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
ASSISTANT_GROQ_MODEL_CANDIDATES=openai/gpt-oss-120b,openai/gpt-oss-20b
ASSISTANT_GROQ_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_GROQ_API_KEY=

# Optional private Onesa producer. Proposed v1; not a deployed Onesa twin API.
# Never enable alongside shared ENABLE_DEMO_ACCOUNTS=true.
ONESA_ENABLED=false
ONESA_INSTALLATION_ID=
ONESA_WORKSPACE_ID=
ONESA_CONTRACT_ID=urn:smart-factory:onesa-proposed:1.0.0
ONESA_INGESTION_URL=
ONESA_APPROVED_ORIGIN=
ONESA_SERVICE_TOKEN=
ONESA_ALLOW_LOCAL_HTTP=false
ONESA_BATCH_SIZE=50
ONESA_MAX_QUEUE_ROWS=10000
ONESA_RETENTION_HOURS=168
ONESA_MAX_ATTEMPTS=12
ONESA_TIMEOUT_MS=10000
