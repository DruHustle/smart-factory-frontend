{
  "name": "smart-factory",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=.env.local NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/_core/index.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview --host",
    "db:push": "DOTENV_CONFIG_PATH=.env.local drizzle-kit generate && DOTENV_CONFIG_PATH=.env.local drizzle-kit migrate",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.local drizzle-kit migrate",
    "e2e": "bash scripts/e2e.sh",
    "e2e:headed": "E2E_HEADED=1 bash scripts/e2e.sh",
    "docs:pdf": "node scripts/render-pdfs.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "deployment:check": "node scripts/check-deployment.mjs",
    "e2e:system": "python3 scripts/cross-repo-smoke.py",
    "vercel:configure": "node scripts/configure-vercel.mjs",
    "onesa:contract:check": "node --import tsx scripts/onesa/generate-contract.ts --check",
    "onesa:contract:generate": "node --import tsx scripts/onesa/generate-contract.ts",
    "onesa:seed": "node --import tsx scripts/onesa/seed-fixture.ts",
    "onesa:receiver": "node --import tsx scripts/onesa/run-receiver.ts",
    "onesa:verify": "node --import tsx scripts/onesa/verify-walkthrough.ts",
    "e2e:equipment": "bash scripts/equipment/e2e.sh",
    "equipment:schemas:check": "node --import tsx scripts/equipment/generate-schemas.ts --check",
    "e2e:security": "bash scripts/security/e2e.sh",
    "e2e:workspace": "bash scripts/workspace/e2e.sh",
    "e2e:experience": "bash scripts/experience/e2e.sh",
    "e2e:public-demo": "bash scripts/public-demo/e2e.sh",
    "e2e:resources": "bash scripts/resources/e2e.sh",
    "e2e:visual-workspaces": "PUBLIC_DEMO_PLAYWRIGHT_CONFIG=playwright.visual-workspaces.config.ts PUBLIC_DEMO_COMPOSE_PROJECT=smart-factory-visual-workspaces-e2e bash scripts/public-demo/e2e.sh"
  },
