{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sourceKey": {
      "type": "string",
      "enum": [
        "temperature",
        "pressure",
        "rpm",
        "vibration"
      ]
    },
    "templateComponentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "meaning": {
      "type": "string",
      "enum": [
        "temperature",
        "pressure",
        "rotational_speed",
        "vibration_velocity"
      ]
    },
    "unit": {
      "type": "string",
      "enum": [
        "Cel",
        "bar",
        "1/min",
        "mm/s"
      ]
    },
    "sourceUnit": {
      "type": "string",
      "enum": [
        "Cel",
        "bar",
        "Pa",
        "1/min",
        "mm/s",
        "m/s2"
      ]
    },
    "expectedIntervalMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 86400000
    }
  },
  "required": [
    "sourceKey",
    "templateComponentId",
    "meaning",
    "unit",
    "expectedIntervalMs"
  ],
  "additionalProperties": false,
  "$id": "urn:smart-factory:equipment:source-binding:1"
}
