{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "urn:smart-factory:onesa-proposed:1.0.0"
    },
    "workspaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9:_.-]+$"
    },
    "results": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "duplicate",
              "retry",
              "rejected"
            ]
          },
          "ingestedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "ok",
              "busy",
              "invalid",
              "conflict",
              "missing_mapping"
            ]
          }
        },
        "required": [
          "eventId",
          "status",
          "ingestedAt",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "workspaceId",
    "results"
  ],
  "additionalProperties": false,
  "$id": "urn:smart-factory:onesa-proposed:1.0.0:receipt"
}
