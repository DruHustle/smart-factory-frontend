{
  "openapi": "3.1.0",
  "info": {
    "title": "PROPOSED Smart Factory → Onesa contract-test receiver",
    "version": "1.0.0",
    "description": "Not implemented by inspected Onesa. Paths and bearer auth are proposals for consumer review."
  },
  "paths": {
    "/proposed/v1/batches": {
      "post": {
        "security": [
          {
            "ServiceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Per-event durable receipts; only accepted/duplicate acknowledge",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Receipt"
                }
              }
            }
          },
          "401": {
            "description": "Credential expired/invalid; suspend until operator rotation"
          },
          "403": {
            "description": "Credential scope mismatch"
          },
          "422": {
            "description": "Invalid batch/version; quarantine"
          },
          "429": {
            "description": "Retry-After, no acceptance"
          },
          "503": {
            "description": "Transient, retry unchanged"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "urn:smart-factory:onesa-proposed:1.0.0"
          },
          "installationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_.-]+$"
          },
          "items": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "installationId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "equipmentId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "componentId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "assetTypeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9:_.-]+$"
                },
                "externalAssetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "target": {
                  "type": "object",
                  "properties": {
                    "workspaceId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    "equipmentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    "componentId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    "mappingVersion": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "workspaceId",
                    "equipmentId",
                    "componentId",
                    "mappingVersion"
                  ],
                  "additionalProperties": false
                },
                "observedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "gatewayReceivedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "live",
                    "simulated",
                    "replay"
                  ]
                },
                "scenarioRunId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "replayRunId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sessionId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sequence": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sourceQuality": {
                  "type": "string",
                  "enum": [
                    "good",
                    "bad",
                    "uncertain",
                    "unknown"
                  ]
                },
                "sourceConnection": {
                  "type": "string",
                  "enum": [
                    "online",
                    "offline",
                    "unknown"
                  ]
                },
                "clockSkew": {
                  "type": "string",
                  "enum": [
                    "within_tolerance",
                    "future",
                    "delayed"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "observation",
                    "source_alarm",
                    "source_connection"
                  ]
                },
                "metric": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "metricId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9:_.-]+$"
                        },
                        "meaning": {
                          "type": "string",
                          "enum": [
                            "temperature",
                            "relative_humidity",
                            "pressure",
                            "rotational_speed",
                            "power",
                            "vibration_acceleration",
                            "vibration_velocity"
                          ]
                        },
                        "valueType": {
                          "type": "string",
                          "const": "number"
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "Cel",
                            "%",
                            "bar",
                            "Pa",
                            "1/min",
                            "W",
                            "kW",
                            "m/s2",
                            "mm/s"
                          ]
                        },
                        "expectedIntervalMs": {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 86400000
                        }
                      },
                      "required": [
                        "metricId",
                        "meaning",
                        "valueType",
                        "unit",
                        "expectedIntervalMs"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sourceEvent": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9:_.-]+$"
                        },
                        "origin": {
                          "type": "string",
                          "const": "source"
                        },
                        "code": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9:_.-]+$"
                        },
                        "state": {
                          "type": "string",
                          "enum": [
                            "active",
                            "cleared"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "origin",
                        "code",
                        "state"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "provenance": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "deviceId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9:_.-]+$"
                        },
                        "sourceKey": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9:_.-]+$"
                        },
                        "rawValue": {
                          "type": "number"
                        },
                        "rawUnit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 24
                        },
                        "conversion": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "rule": {
                                  "type": "string",
                                  "const": "linear"
                                },
                                "factor": {
                                  "type": "number"
                                },
                                "offset": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "rule",
                                "factor",
                                "offset"
                              ],
                              "additionalProperties": false
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "aggregation": {
                          "type": "null"
                        },
                        "timestampOrigin": {
                          "type": "string",
                          "enum": [
                            "device",
                            "gateway"
                          ]
                        },
                        "retained": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "deviceId",
                        "sourceKey",
                        "rawValue",
                        "rawUnit",
                        "conversion",
                        "aggregation",
                        "timestampOrigin",
                        "retained"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "eventId",
                "installationId",
                "equipmentId",
                "componentId",
                "assetTypeId",
                "externalAssetId",
                "target",
                "observedAt",
                "gatewayReceivedAt",
                "mode",
                "scenarioRunId",
                "replayRunId",
                "sessionId",
                "sequence",
                "sourceQuality",
                "sourceConnection",
                "clockSkew",
                "kind",
                "metric",
                "value",
                "sourceEvent",
                "provenance"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema",
          "installationId",
          "workspaceId",
          "items"
        ],
        "additionalProperties": false
      },
      "Receipt": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "schema": {
            "type": "string",
            "const": "urn:smart-factory:onesa-proposed:1.0.0"
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_.-]+$"
          },
          "results": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "eventId": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "accepted",
                    "duplicate",
                    "retry",
                    "rejected"
                  ]
                },
                "ingestedAt": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "busy",
                    "invalid",
                    "conflict",
                    "missing_mapping"
                  ]
                }
              },
              "required": [
                "eventId",
                "status",
                "ingestedAt",
                "code"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema",
          "workspaceId",
          "results"
        ],
        "additionalProperties": false
      },
      "Registration": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "equipmentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "externalAssetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_.-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "assetTypeId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_.-]+$"
          },
          "serialNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "components": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "componentId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "parentComponentId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "componentId",
                "name",
                "parentComponentId"
              ],
              "additionalProperties": false
            }
          },
          "bindings": {
            "minItems": 1,
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceKey": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "temperature",
                        "humidity",
                        "pressure",
                        "rpm",
                        "power",
                        "vibration"
                      ]
                    },
                    {
                      "type": "string",
                      "pattern": "^assetSignals\\.[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                    }
                  ]
                },
                "componentId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "metric": {
                  "type": "object",
                  "properties": {
                    "metricId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[A-Za-z0-9:_.-]+$"
                    },
                    "meaning": {
                      "type": "string",
                      "enum": [
                        "temperature",
                        "relative_humidity",
                        "pressure",
                        "rotational_speed",
                        "power",
                        "vibration_acceleration",
                        "vibration_velocity"
                      ]
                    },
                    "valueType": {
                      "type": "string",
                      "const": "number"
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "Cel",
                        "%",
                        "bar",
                        "Pa",
                        "1/min",
                        "W",
                        "kW",
                        "m/s2",
                        "mm/s"
                      ]
                    },
                    "expectedIntervalMs": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 86400000
                    }
                  },
                  "required": [
                    "metricId",
                    "meaning",
                    "valueType",
                    "unit",
                    "expectedIntervalMs"
                  ],
                  "additionalProperties": false
                },
                "sourceUnit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 24
                }
              },
              "required": [
                "sourceKey",
                "componentId",
                "metric",
                "sourceUnit"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "equipmentId",
          "externalAssetId",
          "deviceId",
          "name",
          "assetTypeId",
          "serialNumber",
          "components",
          "bindings"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Proposed token-bound installation/workspace; not Onesa session auth"
      }
    }
  }
}
